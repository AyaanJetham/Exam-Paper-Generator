# ===========================================
# TutorVision API Keys Configuration
# ===========================================
# Copy this file to .env and fill in your keys.
# Get free API keys from the services below.
# You need AT LEAST ONE key, but more = better failover.

# Groq (Fast LLM inference) - https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# HuggingFace Inference - https://huggingface.co/settings/tokens
HF_API_KEY=

# Cerebras (Fast inference) - https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Together AI - https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
